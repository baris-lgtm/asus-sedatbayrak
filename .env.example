# =============================================================================
# ASUS × Sedat Bayrak Workshop — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayın. GERÇEK SIRLARI BU DOSYAYA YAZMAYIN.
# NEXT_PUBLIC_ ile başlayan her şey tarayıcıya gider → asla gizli anahtar koymayın.
# =============================================================================

# --- Site -------------------------------------------------------------------
# Canlı ortamda kendi alan adınız (QR davetiye bağlantıları buna göre üretilir).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
# Public anahtar: yeni projelerde "publishable key" (sb_publishable_...),
# eski projelerde "anon key". Kurulumda SDK sürümüne göre doğrulanacak.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# YALNIZCA SUNUCU. Yeni projelerde "secret key" (sb_secret_...), eski projelerde service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Davetiye token'ları -----------------------------------------------------
# En az 32 karakter rastgele değer. Üretmek için: openssl rand -base64 48
# DEĞİŞTİRİLİRSE gönderilmiş tüm QR kodları geçersiz olur.
INVITATION_TOKEN_SECRET=

# Rate limit anahtarlarında IP'yi hash'lemek için (ham IP saklanmaz).
# openssl rand -base64 32
RATE_LIMIT_SALT=

# --- E-posta (Resend) --------------------------------------------------------
RESEND_API_KEY=
# Resend'de DOĞRULANMIŞ bir domain'den olmalı. Örn: "ASUS Workshop <workshop@alanadiniz.com>"
EMAIL_FROM=
# Opsiyonel: katılımcıların yanıtlayacağı adres
EMAIL_REPLY_TO=

# --- Spam koruması (opsiyonel) -----------------------------------------------
# Cloudflare Turnstile. Boş bırakılırsa CAPTCHA devre dışı, yalnızca rate limit + honeypot çalışır.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analitik (opsiyonel; yalnızca çerez izni verilirse yüklenir) -----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# --- Bakım işleri ------------------------------------------------------------
# Vercel Cron → /api/cron/purge çağrısını doğrulamak için. openssl rand -base64 32
CRON_SECRET=
